{
  "expo": {
    "name": "Swipe4Change",
    "slug": "swipe4change",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.lookaware.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "org.lookaware.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "server"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@clerk/expo",
      "expo-notifications",
      "expo-web-browser",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Swipe4Change uses your location once to find your city. Only the city and state are saved."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Swipe4Change lets you attach a photo of the problem to a petition.",
          "cameraPermission": "Swipe4Change lets you take a photo of the problem for a petition."
        }
      ]
    ],
    "scheme": ["swipe4change", "lookaware"]
  }
}
