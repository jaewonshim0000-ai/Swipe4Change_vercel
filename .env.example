# Hosted Supabase is the default. Copy to .env and enter public project settings.
# Keep existing values in .env.local; they override .env.
EXPO_PUBLIC_BACKEND=supabase
# Configure Clerk third-party authentication in the hosted Supabase dashboard.
# For an offline fictional demo only, explicitly set EXPO_PUBLIC_BACKEND=demo.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY
# Legacy projects can leave the publishable key empty and set their anon JWT here.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_PUBLIC_CLERK_KEY
# AI review (report screening, hidden For You tags) and the AI recipient finder for the local
# demo. Read only by the Expo dev server's /api routes and never bundled into the app (no
# EXPO_PUBLIC_ prefix). Leave it empty to use the keyword-rule fallback; the recipient finder then
# explains that it needs a key. Hosted mode sets it as an Edge Function secret instead.
ANTHROPIC_API_KEY=
# State legislators for the officials lookup (free key from https://openstates.org/accounts/signup/).
# Server-only like the key above. Without it, only members of Congress are shown.
OPENSTATES_API_KEY=
# Never add a Supabase service-role key or Clerk secret key to this app.
