# Local demo works with no credentials. Copy this file to .env if needed.
EXPO_PUBLIC_BACKEND=demo
# For hosted mode, use supabase above and configure Clerk third-party auth in Supabase.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_PUBLIC_CLERK_KEY
# AI review (report screening and hidden For You tags) for the local demo. Read only by the Expo
# dev server's /api/ai route and never bundled into the app (no EXPO_PUBLIC_ prefix). Leave it
# empty to use the keyword-rule fallback. Hosted mode sets it as an Edge Function secret instead.
ANTHROPIC_API_KEY=
# Never add a Supabase service-role key or Clerk secret key to this app.
